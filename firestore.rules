rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health-check probe for initial boot connection verification
    match /test/connection {
      allow read: if true;
    }

    // Helper functions for security validation
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // UserProfile Schema Validation
    function isValidUserProfile(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.email is string
        && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('createdAt' in data) || data.createdAt is string)
        && (!('updatedAt' in data) || data.updatedAt is string)
        && data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']);
    }

    // UserPreferences Schema Validation
    function isValidUserPreferences(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && (!('soundAlerts' in data) || data.soundAlerts is bool)
        && (!('autoRefreshInterval' in data) || (data.autoRefreshInterval is number && data.autoRefreshInterval >= 1 && data.autoRefreshInterval <= 300))
        && (!('pinnedSymbols' in data) || (data.pinnedSymbols is string && data.pinnedSymbols.size() <= 500))
        && (!('updatedAt' in data) || data.updatedAt is string)
        && data.keys().hasAll(['userId'])
        && data.keys().hasOnly(['userId', 'soundAlerts', 'autoRefreshInterval', 'pinnedSymbols', 'updatedAt']);
    }

    // WatchlistSymbol Schema Validation
    function isValidWatchlistSymbol(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.id is string
        && isValidId(data.id)
        && data.symbol is string
        && data.symbol.size() <= 20
        && data.symbol.matches('^[A-Z0-9]+$')
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && (!('addedAt' in data) || data.addedAt is string)
        && data.keys().hasAll(['id', 'userId', 'symbol'])
        && data.keys().hasOnly(['id', 'userId', 'symbol', 'note', 'addedAt']);
    }

    // TradeAnnotation Schema Validation
    function isValidTradeAnnotation(data, userId) {
      return data.userId == request.auth.uid
        && data.userId == userId
        && data.id is string
        && isValidId(data.id)
        && data.symbol is string
        && data.symbol.size() <= 20
        && (!('positionId' in data) || (data.positionId is string && data.positionId.size() <= 100))
        && data.content is string
        && data.content.size() <= 1000
        && (!('createdAt' in data) || data.createdAt is string)
        && data.keys().hasAll(['id', 'userId', 'symbol', 'content'])
        && data.keys().hasOnly(['id', 'userId', 'symbol', 'positionId', 'content', 'createdAt']);
    }

    // Match rules for /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying across all user profiles
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().email == existing().email;
      allow delete: if isOwner(userId);

      // Preferences subcollection
      match /preferences/{prefId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(prefId)
          && isValidUserPreferences(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(prefId)
          && isValidUserPreferences(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      // Watchlist subcollection
      match /watchlist/{symbolId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(symbolId)
          && isValidWatchlistSymbol(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(symbolId)
          && isValidWatchlistSymbol(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().symbol == existing().symbol;
        allow delete: if isOwner(userId);
      }

      // Annotations subcollection
      match /annotations/{annotationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(annotationId)
          && isValidTradeAnnotation(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(annotationId)
          && isValidTradeAnnotation(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
