{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and authentication details",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth User ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name or display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar image URL",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User dashboard, audio alert, and display settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner User ID"
        },
        "soundAlerts": {
          "type": "boolean",
          "description": "Enable sound alerts on bullish strategy transitions"
        },
        "autoRefreshInterval": {
          "type": "number",
          "description": "Client-side refresh cadence in seconds"
        },
        "pinnedSymbols": {
          "type": "string",
          "description": "Comma-separated pinned trading symbols",
          "maxLength": 500
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId"]
    },
    "WatchlistSymbol": {
      "title": "WatchlistSymbol",
      "description": "Pinned cryptocurrency trading pair for quick scanning",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Watchlist record unique ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner User ID"
        },
        "symbol": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[A-Z0-9]+$",
          "description": "Trading pair symbol, e.g., BTCUSDT"
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional user note about this pair"
        },
        "addedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when added"
        }
      },
      "required": ["id", "userId", "symbol"]
    },
    "TradeAnnotation": {
      "title": "TradeAnnotation",
      "description": "Personal annotations and post-trade analysis for positions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique annotation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner User ID"
        },
        "symbol": {
          "type": "string",
          "maxLength": 20,
          "description": "Trading pair symbol"
        },
        "positionId": {
          "type": "string",
          "maxLength": 100,
          "description": "Associated position or order ID"
        },
        "content": {
          "type": "string",
          "maxLength": 1000,
          "description": "Analysis notes, thesis, or retrospective"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "symbol", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Personal user profile and authentication record"
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": "UserPreferences",
      "description": "Customizable user dashboard preferences"
    },
    "/users/{userId}/watchlist/{symbolId}": {
      "schema": "WatchlistSymbol",
      "description": "User custom watchlist of priority Binance pairs"
    },
    "/users/{userId}/annotations/{annotationId}": {
      "schema": "TradeAnnotation",
      "description": "User notes and commentary on trades or positions"
    }
  }
}
