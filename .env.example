# ==============================================================================
# Binance 5-Minute Auto Trader - Environment Configuration
# ==============================================================================

# Server & Runtime Configuration
PORT=10000
NODE_ENV=production

# Public Application Origin (Used for production CORS & Security)
APP_ORIGIN=https://your-app.onrender.com
ALLOWED_ORIGINS=https://your-app.onrender.com

# Persistent Storage Directory (e.g. Render Persistent Disk mount path /var/data or .data)
DATA_DIR=.data

# Admin Authentication Token (Optional override; if omitted, automatically generated & persisted)
ADMIN_TOKEN=

# Binance API Credentials (Set in cloud environment secrets for live execution)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_BASE_URL=https://api.binance.com

# Security - 64-char Hex Key for AES-256-GCM encryption of Binance API secrets at rest
# Generate a secure key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# Scanner & Market Data Execution
SCAN_INTERVAL_MS=300000
DEFAULT_INTERVAL=5m
MAX_SYMBOLS_PER_SCAN=0
MIN_24H_VOLUME=1000000
CANDLE_LIMIT=250
REQUEST_CONCURRENCY=8

# Paper Trading Defaults
PAPER_STARTING_BALANCE=1000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# Fixed Trade Sizing & Risk Controls
DEFAULT_FIXED_TRADE_AMOUNT=100
MAX_TRADE_AMOUNT=1000
MAX_OPEN_POSITIONS=5
MIN_USDT_RESERVE=100
SYMBOL_COOLDOWN_MINUTES=30

# Strategy Thresholds
PRE_BULLISH_SCORE_MIN=65
STRONG_BULLISH_SCORE_MIN=80
WEAKENING_THRESHOLD=70
