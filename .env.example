# Server & Runtime Configuration
PORT=10000
NODE_ENV=production
DATABASE_URL=postgresql://binance_trader:password@dpg-xxxxx-a.render.com/binance_trader
DATA_DIR=/data

# Origins for CORS
APP_ORIGIN=https://YOUR-APP.onrender.com
ALLOWED_ORIGINS=https://YOUR-APP.onrender.com

# Administrative Security & Encryption (Generate long random strings)
ADMIN_ACCESS_TOKEN=12345
ADMIN_TOKEN=12345
CREDENTIAL_ENCRYPTION_KEY=your_32_byte_hex_or_passphrase_here

# Live Trading Safety Guard (Default: false)
LIVE_TRADING_ENABLED=false

# Binance Spot API (Optional initial environment credentials)
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Scanner & Market Data
SCAN_INTERVAL_MS=120000
DEFAULT_INTERVAL=5m
MAX_SYMBOLS_PER_SCAN=0
MIN_24H_VOLUME=1000000
CANDLE_LIMIT=250

# Paper Trading Defaults
PAPER_STARTING_BALANCE=1000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_BPS=5

# Fixed Trade Sizing & Risk Controls
DEFAULT_FIXED_TRADE_AMOUNT=100
MAX_TRADE_AMOUNT=10000
MAX_OPEN_POSITIONS=5
MIN_USDT_RESERVE=100
SYMBOL_COOLDOWN_MINUTES=30

# Strategy Entry Thresholds
PRE_BULLISH_SCORE_MIN=65
STRONG_BULLISH_SCORE_MIN=80
WEAKENING_THRESHOLD=70

# Exit Architecture Parameters
TAKE_PROFIT_PERCENT=2.0
STOP_LOSS_PERCENT=3.0
MIN_PROFIT_TO_TECHNICAL_EXIT_PERCENT=0.20
MAX_EXIT_PRICE_AGE_MS=5000
